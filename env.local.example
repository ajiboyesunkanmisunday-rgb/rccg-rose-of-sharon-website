# Copy this file to .env.local (rename it) (same folder) and fill it in, then restart the local sites: node scripts/dev-all.mjs
# .env.local is never committed. Use a read-only account made for the website, not a personal admin login.
# The same two values go in Vercel > each project > Settings > Environment Variables (main, media, training).
ROS_API_EMAIL=
ROS_API_PASSWORD=
