{
  "name": "rccg-ros-sites",
  "private": true,
  "description": "RCCG Rose of Sharon websites: main, youth, training and media. Four separately deployable apps sharing one package.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:main": "npm run dev -w @ros/main",
    "dev:youth": "npm run dev -w @ros/youth",
    "dev:training": "npm run dev -w @ros/training",
    "dev:media": "npm run dev -w @ros/media",
    "build": "npm run build -w @ros/main -w @ros/youth -w @ros/training -w @ros/media",
    "build:main": "npm run build -w @ros/main",
    "build:youth": "npm run build -w @ros/youth",
    "build:training": "npm run build -w @ros/training",
    "build:media": "npm run build -w @ros/media",
    "assets": "node scripts/sync-assets.mjs"
  }
}
